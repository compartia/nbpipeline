# NBP is for Notebook Pipeline 
NPB_WORK_DIR = '/usr/local/example/Arbeitsverzeichnis'
NPB_SERVER_HOST= 0.0.0.0 ## zeros to listen an all  hosts
NPB_SERVER_PORT=8088

# possible to set with seconds like 
# NBP_DEFAULT_SCHEDULE_INTERVAL_MINUTES=1:40 (== 100 sec)
NBP_DEFAULT_SCHEDULE_INTERVAL_MINUTES=10 


NBP_LOG_LEVEL=DEBUG #or INFO # or ERROR
NBP_LOG_LEVEL_FILE=/path/to/your/log/dir/file.log

NBP_EXEC_JOBS_BEFORE_SCHEDULE=true or anything 

NBP_STOP_ON_ERROR=False # do not stop scheduler even if a notebook errorred 